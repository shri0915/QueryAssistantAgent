# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Local LLM (Ollama-compatible)
LOCAL_LLM_URL=http://localhost:11434/api/chat
LOCAL_LLM_MODEL=gemma3:4b
LOCAL_LLM_TIMEOUT_SECONDS=60

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Azure Data API Builder MCP Configuration
# Set to "true" to use MCP protocol (requires DAB MCP server support)
# Set to "false" to use direct database connection (default)
USE_MCP=false

# Path to your DAB configuration file (dab-config.json) - used when MCP is enabled
DAB_CONFIG_PATH=./dab-config.json

# DAB MCP server command (default: npx)
DAB_SERVER_COMMAND=npx

# DAB MCP server package (default: @azure/data-api-builder-mcp)
DAB_SERVER_ARGS=@azure/data-api-builder-mcp

# Database Connection String (used by DAB or direct connection)
# Examples:
# SQL Server (Local): Server=localhost;Database=master;Trusted_Connection=True;TrustServerCertificate=True
# SQL Server (Azure): Server=myserver.database.windows.net;Database=mydb;User Id=username;Password=password;Encrypt=True
# PostgreSQL: Host=localhost;Port=5432;Database=mydb;Username=postgres;Password=yourpassword
# MySQL: server=localhost;port=3306;database=mydb;user=root;password=yourpassword
DATABASE_CONNECTION_STRING=your_database_connection_string_here
