# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Azure Data API Builder MCP Configuration
# Path to your DAB configuration file (dab-config.json)
DAB_CONFIG_PATH=./dab-config.json

# DAB MCP server command (default: npx)
DAB_SERVER_COMMAND=npx

# DAB MCP server package (default: @azure/data-api-builder-mcp)
DAB_SERVER_ARGS=@azure/data-api-builder-mcp

# Database Connection String (used by DAB)
# Examples:
# SQL Server: Server=localhost;Database=mydb;User Id=sa;Password=yourpassword;TrustServerCertificate=True
# PostgreSQL: Host=localhost;Database=mydb;Username=postgres;Password=yourpassword
# MySQL: server=localhost;database=mydb;user=root;password=yourpassword
DATABASE_CONNECTION_STRING=your_database_connection_string_here
